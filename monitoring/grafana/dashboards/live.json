{
 "uid": "live",
 "title": "Live: ORM under load",
 "editable": false,
 "graphTooltip": 1,
 "time": {
  "from": "now-1m",
  "to": "now"
 },
 "refresh": "1s",
 "timezone": "utc",
 "schemaVersion": 41,
 "timepicker": {
  "refresh_intervals": [
   "1s",
   "5s",
   "10s",
   "30s"
  ]
 },
 "panels": [
  {
   "id": 1,
   "type": "timeseries",
   "title": "Requests per second",
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 12,
    "h": 11
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(rate(requests_total[3s])) or vector(0)",
     "legendFormat": "API",
     "range": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "decimals": 0,
     "min": 0,
     "custom": {
      "lineWidth": 4,
      "fillOpacity": 8,
      "showPoints": "never",
      "spanNulls": false
     }
    },
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "API"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "#8CC84B"
        }
       }
      ]
     }
    ]
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
     "showLegend": true
    },
    "tooltip": {
     "mode": "multi"
    }
   }
  },
  {
   "id": 2,
   "type": "timeseries",
   "title": "SQL statements per second",
   "gridPos": {
    "x": 12,
    "y": 0,
    "w": 12,
    "h": 11
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(rate(pg_statements_total[3s])) or vector(0)",
     "legendFormat": "Postgres",
     "range": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "decimals": 0,
     "min": 0,
     "custom": {
      "lineWidth": 4,
      "fillOpacity": 8,
      "showPoints": "never",
      "spanNulls": false
     }
    },
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "Postgres"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "#4F8FD6"
        }
       }
      ]
     }
    ]
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
     "showLegend": true
    },
    "tooltip": {
     "mode": "multi"
    }
   }
  },
  {
   "id": 3,
   "type": "timeseries",
   "title": "CPU (cores)",
   "gridPos": {
    "x": 0,
    "y": 11,
    "w": 12,
    "h": 11
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(rate(namedprocess_namegroup_cpu_seconds_total{groupname=\"server\"}[3s])) or vector(0)",
     "legendFormat": "Node",
     "range": true
    },
    {
     "refId": "B",
     "expr": "sum(rate(namedprocess_namegroup_cpu_seconds_total{groupname=\"postgres\"}[3s])) or vector(0)",
     "legendFormat": "Postgres",
     "range": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "decimals": 1,
     "min": 0,
     "custom": {
      "lineWidth": 4,
      "fillOpacity": 8,
      "showPoints": "never",
      "spanNulls": false
     }
    },
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "Node"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "#8CC84B"
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "Postgres"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "#4F8FD6"
        }
       }
      ]
     }
    ]
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
     "showLegend": true
    },
    "tooltip": {
     "mode": "multi"
    }
   }
  },
  {
   "id": 4,
   "type": "timeseries",
   "title": "Node memory",
   "gridPos": {
    "x": 12,
    "y": 11,
    "w": 12,
    "h": 11
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(namedprocess_namegroup_memory_bytes{groupname=\"server\",memtype=\"resident\"}) or vector(0)",
     "legendFormat": "Node",
     "range": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "bytes",
     "decimals": 0,
     "min": 0,
     "custom": {
      "lineWidth": 4,
      "fillOpacity": 8,
      "showPoints": "never",
      "spanNulls": false
     }
    },
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "Node"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "#8CC84B"
        }
       }
      ]
     }
    ]
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
     "showLegend": true
    },
    "tooltip": {
     "mode": "multi"
    }
   }
  }
 ]
}